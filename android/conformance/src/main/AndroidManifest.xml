<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Intentionally no uses-permission entries. The three OS-started facade
         activities are caller-guarded; this APK does not hold that permission. -->
    <queries><package android:name="com.android.systemui" /><package android:name="org.wonad.desktop.test" /></queries>
    <instrumentation android:name=".ConformanceInstrumentation"
        android:targetPackage="org.wonad.desktop" android:functionalTest="true" />
    <application android:label="@string/app_name" android:icon="@android:drawable/ic_menu_info_details"
        android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ConformanceControlActivity" android:exported="false"
            android:launchMode="singleTask" android:excludeFromRecents="true" />
        <activity android:name=".ExternalHomeActivity" android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:launchMode="singleTop" android:resizeableActivity="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".ExternalShellActivity" android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE"
            android:theme="@style/ConformanceTransparentTheme"
            android:resizeableActivity="true"
            android:excludeFromRecents="true" android:enableOnBackInvokedCallback="false"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|density|orientation" />
        <activity android:name=".LauncherActivity" android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE"
            android:theme="@style/ConformanceTransparentTheme"
            android:resizeableActivity="true" android:excludeFromRecents="true"
            android:enableOnBackInvokedCallback="false" />
        <service android:name=".ConformanceService" android:exported="false" />
    </application>
</manifest>
