@@ -5929,5 +5929,24 @@ public abstract class RecentsView<
         successCallback.run();
     }
 
+    /** The phone Recents card supplies only observations. Shell validates the
+     * exact live task and chooses Wonad's last-focused external monitor after
+     * Overview has returned input focus to the phone.
+     */
+    public void sendTaskToWonad(TaskContainer taskContainer) {
+        final TaskKey selected = taskContainer.getTask().key;
+        switchToScreenshot(() -> finishRecentsAnimation(/* toHome= */true, /* shouldPip= */false,
+                () -> {
+                    if (mSystemUiProxy.sendTaskToWonad(selected.id, selected.userId,
+                            selected.lastActiveTime, selected.baseActivity,
+                            selected.token == null ? null : selected.token.asBinder())) {
+                        dismissTaskView(taskContainer.getTaskView(), /*removeTask*/ false);
+                    } else {
+                        Toast.makeText(getContext(), R.string.wonad_transfer_unavailable,
+                                Toast.LENGTH_SHORT).show();
+                    }
+                }));
+    }
+
 
     // Logs when the orientation of Overview changes. We log both real and fake orientation changes.
diff --git a/quickstep/src/com/android/quickstep/WonadSendShortcut.kt b/quickstep/src/com/android/quickstep/WonadSendShortcut.kt
new file mode 100644
--- /dev/null
+++ b/quickstep/src/com/android/quickstep/WonadSendShortcut.kt
@@ -0,0 +1,51 @@
+package com.android.quickstep
+
+import android.view.Display
+import android.view.View
+import com.android.launcher3.AbstractFloatingViewHelper
+import com.android.launcher3.R
+import com.android.launcher3.popup.SystemShortcut
+import com.android.quickstep.views.RecentsView
+import com.android.quickstep.views.RecentsViewContainer
+import com.android.quickstep.views.TaskContainer
+import javax.inject.Inject
+
+/** Phone Recents offers only a live, single-task Wonad transfer. Shell resolves
+ * the actual task and destination again when the user taps this entry.
+ */
+class WonadSendShortcut private constructor(
+    container: RecentsViewContainer,
+    helper: AbstractFloatingViewHelper,
+    private val taskContainer: TaskContainer,
+) : SystemShortcut<RecentsViewContainer>(
+    R.drawable.ic_external_display,
+    R.string.recent_task_option_send_to_wonad,
+    container,
+    taskContainer.itemInfo,
+    taskContainer.taskView,
+    helper,
+) {
+    override fun onClick(view: View) {
+        dismissTaskMenuView()
+        mTarget.getOverviewPanel<RecentsView<*, *>>().sendTaskToWonad(taskContainer)
+    }
+
+    class Factory @Inject constructor(
+        private val helper: AbstractFloatingViewHelper,
+    ) : TaskShortcutFactory {
+        override fun getShortcuts(
+            container: RecentsViewContainer,
+            taskContainer: TaskContainer,
+        ): List<WonadSendShortcut>? {
+            val key = taskContainer.task.key
+            val validKey = key.displayId == Display.DEFAULT_DISPLAY && key.baseActivity != null &&
+                key.token != null && key.lastActiveTime > 0
+            if (!validKey) return null
+            val allowed = SystemUiProxy.INSTANCE.get(container.asContext())
+                .canSendTaskToWonad(key.id, key.userId, key.lastActiveTime, key.baseActivity,
+                    key.token?.asBinder())
+            if (!allowed) return null
+            return listOf(WonadSendShortcut(container, helper, taskContainer))
+        }
+    }
+}
