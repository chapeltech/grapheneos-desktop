+
+    @JvmStatic fun installRecent(context: Context, wm: WindowManagerInternal,
+        pair: Any, focus: Any?, action: OwnerInstallAction,
+        rollback: OwnerInstallAction): Boolean =
+        state.installRecentStarted(pair as WonadPolicyKeyContainment.PairToken, focus,
+            resolver(context, wm), rollback = { rollback.run(OwnerInstall(it)) }) {
