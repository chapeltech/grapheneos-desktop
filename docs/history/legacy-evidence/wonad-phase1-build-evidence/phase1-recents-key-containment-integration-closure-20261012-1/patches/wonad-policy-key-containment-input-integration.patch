+        state.installEscapePending(pair as WonadPolicyKeyContainment.PairToken,
+            focus, completion, resolver(context, wm),
+            rollback = { rollback.run(EscapeInstall(it)) }) { registration ->
+                action.run(EscapeInstall(registration))
+            } != null
+
+    @JvmStatic fun completeMeta(pair: Any): Any? =
+        state.completeMeta(pair as WonadPolicyKeyContainment.PairToken)
+    @JvmStatic fun completeCaps(pair: Any): Any? =
+        state.completeCaps(pair as WonadPolicyKeyContainment.PairToken)
+    @JvmStatic fun completeAltTab(pair: Any): Any? =
+        state.completeAltTab(pair as WonadPolicyKeyContainment.PairToken)
