+    @JvmStatic fun completeEscapePair(pair: Any): Any? =
+        state.completeEscape(pair as WonadPolicyKeyContainment.PairToken)
+    @JvmStatic fun completeEscape(completion: Any): Any? =
+        state.completeEscape(completion)
+
+    /** Delayed action and claim retirement linearize on the pure-state lock. */
+    @JvmStatic fun dispatchEscape(context: Context, wm: WindowManagerInternal,
+        completion: Any, action: EscapeAction): Boolean =
+        state.dispatchEscape(completion, resolver(context, wm)) { owner ->
+            action.run(OwnerEvent(owner.pair, owner.focus, owner.completion))
+        }
+
+    @JvmStatic fun ownerEvent(owner: Any): OwnerEvent = when (owner) {
+        is WonadPolicyKeyContainment.RecentOwner -> OwnerEvent(
+            owner.pair, owner.focus, null)
+        is WonadPolicyKeyContainment.MetaOwner -> OwnerEvent(
+            owner.pair, owner.focus, null)
+        is WonadPolicyKeyContainment.CapsOwner -> OwnerEvent(
+            owner.meta, owner.focus, null)
+        is WonadPolicyKeyContainment.AltTabOwner -> OwnerEvent(
+            owner.tab, owner.focus, null)
+        is WonadPolicyKeyContainment.EscapeOwner -> OwnerEvent(
+            owner.pair, owner.focus, owner.completion)
+        else -> throw IllegalArgumentException("Unknown policy owner")
+    }
+
+    @JvmStatic fun mutationEpoch(): Long = state.mutationEpoch()
+
+    @JvmStatic fun reconcileDevices(present: IntArray, allKeysReleased: Boolean,
+        expectedEpoch: Long): Decision {
+        val raw = state.reconcileDevices(present.toSet(), allKeysReleased, expectedEpoch)
+        return Decision(raw, WonadPolicyKeyContainment.PhysicalPair(-1, -1, 0))
+    }
+
+    @JvmStatic fun removeDevice(device: Int): Decision {
+        val raw = state.removeDevice(device)
+        return Decision(raw, WonadPolicyKeyContainment.PhysicalPair(device, -1, 0))
+    }
+
+    @JvmStatic fun registerCleanupListener(listener: CleanupListener) {
+        check(cleanupListener == null || cleanupListener === listener) {
+            "Wonad policy cleanup listener already registered"
+        }
+        cleanupListener = listener
+    }
+
+    private fun publishCleanup(raw: WonadPolicyKeyContainment.Decision) {
+        cleanupListener?.onCleanup(Decision(raw,
+            WonadPolicyKeyContainment.PhysicalPair(-1, -1, 0)))
+    }
+
+    /** Called synchronously before UiBridge publishes a new containment
+     * barrier. The exact claim—not its display number—is the authority key. */
+    @JvmStatic fun onClaimContainmentChanged(claim: WonadUiBridge.ShortcutClaim,
+        blocked: Boolean) {
+        publishCleanup(state.updateClaimStatus(claim,
+            if (blocked) WonadPolicyKeyContainment.ClaimStatus.BLOCKED else null))
+    }
+
+    /** Called synchronously before UiBridge unpublishes the exact claim. */
+    @JvmStatic fun onClaimRetiring(claim: WonadUiBridge.ShortcutClaim) {
+        publishCleanup(state.updateClaimStatus(
+            claim, WonadPolicyKeyContainment.ClaimStatus.RETIRED))
+    }
+
+    /** Called only after UiBridge unpublishes the exact claim. */
+    @JvmStatic fun onClaimRetired(claim: WonadUiBridge.ShortcutClaim) {
+        state.forgetClaim(claim)
+    }
+
+    @JvmStatic fun claimBlocked(claim: WonadUiBridge.ShortcutClaim): Boolean =
+        state.claimBlocked(claim)
