+        meta: Any, alt: Any, focus: Any?, action: OwnerInstallAction,
+        rollback: OwnerInstallAction): Boolean =
+        state.installCapsPending(meta as WonadPolicyKeyContainment.PairToken,
+            alt as WonadPolicyKeyContainment.PairToken, focus, resolver(context, wm),
+            rollback = { rollback.run(OwnerInstall(it)) }) {
+                action.run(OwnerInstall(it))
+            } != null
+
+    @JvmStatic fun installAltTab(context: Context, wm: WindowManagerInternal,
+        tab: Any, focus: Any?, action: OwnerInstallAction,
+        rollback: OwnerInstallAction): Boolean =
+        state.installAltTabStarted(tab as WonadPolicyKeyContainment.PairToken, focus,
+            resolver(context, wm), rollback = { rollback.run(OwnerInstall(it)) }) {
+                action.run(OwnerInstall(it))
