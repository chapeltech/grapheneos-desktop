+++ b/android/input-integration/src/org/wonad/server/input/WonadPolicyKeyAdapter.kt
@@ -0,0 +1,483 @@
+package org.wonad.server.input
+
+import android.content.Context
+import android.os.IBinder
+import android.view.KeyEvent
+import com.android.server.wm.WindowManagerInternal
+import com.android.server.wm.WonadUiBridge
+
+/** Minimal Java-facing adapter. Only private platform JNI/policy wiring changes. */
+internal object WonadPolicyKeyAdapter {
+    const val ROLE_ORDINARY = 0
+    const val ROLE_APP_SWITCH = 1
+    const val ROLE_RECENT_APPS = 2
+    const val ROLE_ALL_APPS = 3
+    const val ROLE_SYSTEM_ACTION = 4
+    const val ROLE_META = 5
+    const val ROLE_ALT = 6
+    const val ROLE_TAB = 7
+    const val ROLE_ESCAPE = 8
+
+    class Decision internal constructor(
+        internal val raw: WonadPolicyKeyContainment.Decision,
+        private val physical: WonadPolicyKeyContainment.PhysicalPair,
+        private val display: Int,
+        @JvmField val nativeCompletion: Boolean,
+    ) {
+        @JvmField val consume = raw.consume
+        @JvmField val application = raw.application
+        @JvmField val stock = raw.stock
+        @JvmField val saturated = raw.saturated
+        @JvmField val pair: Any? = raw.pair
+
+        internal fun matches(value: KeyEvent): Boolean =
+            physical.device == value.deviceId &&
+                physical.keyCode == value.keyCode &&
+                physical.downTime == value.downTime && display == value.displayId
+    }
+
+    private val state = WonadPolicyKeyContainment()
+    private const val MAX_PENDING_EVENTS = 256
+
+    internal data class DeliveredAuthority(
+        val token: Long,
+        val eventId: Int,
+        val physical: WonadPolicyKeyContainment.PhysicalPair,
+        val display: Int,
+        val origin: WonadPolicyKeyContainment.ClaimLineage,
+        val pair: WonadPolicyKeyContainment.PairToken,
+    )
+    private val deliveryLock = Any()
+    /*
+     * Only the private native nonce is the completion key. KeyEvent.id is
+     * collision-prone evidence, never authority. Native F1/F2 re-resolution
+     * follows the exact KeyEntry but still leaves raw target isolation OPEN.
+     */
+    private val deliveries = LinkedHashMap<Long, DeliveredAuthority>()
+
+    internal class AdmissionCall internal constructor(
+        internal val token: Long,
+        internal val previous: AdmissionCall?,
+    ) {
+        internal var registered: DeliveredAuthority? = null
+        internal var provisional: WonadPolicyKeyContainment.PairToken? = null
+    }
+    private val admissionCall = ThreadLocal<AdmissionCall?>()
+
+    @JvmStatic
+    fun beginAdmissionCall(token: Long): Any = AdmissionCall(token, admissionCall.get()).also {
+        admissionCall.set(it)
+    }
+
+    /** Compare-own-record rollback: duplicate/non--3 calls cannot remove another call's record. */
+    @JvmStatic
+    fun finishAdmissionCall(value: Any, result: Long): Long {
+        val call = value as AdmissionCall
+        check(admissionCall.get() === call) { "Admission call order changed" }
+        val accepted = synchronized(deliveryLock) {
+            val own = call.registered
+            if (result == -3L && own != null && deliveries[call.token] === own) {
+                true
+            } else {
+                if (own != null && deliveries[call.token] === own) deliveries.remove(call.token)
+                false
+            }
+        }
+        if (result != -3L || !accepted) {
+            call.provisional?.let { state.failApplicationPair(it, it.physical) }
+        }
+        admissionCall.set(call.previous)
+        return if (result == -3L && !accepted) -1L else result
+    }
+
+    internal class UnhandledScope private constructor(
+        internal val focus: IBinder?,
+        internal val sourceEvent: KeyEvent,
+        internal val eventId: Int,
+        internal val physical: WonadPolicyKeyContainment.PhysicalPair,
+        internal val display: Int,
+        val origin: WonadPolicyKeyContainment.ClaimLineage?,
+        val blocked: Boolean,
+        internal val trustedClaimed: Boolean,
+        internal val previous: UnhandledScope?,
+        internal val previousFallback: FallbackScope?,
+    ) {
+        companion object {
+            internal fun create(focus: IBinder?, sourceEvent: KeyEvent, eventId: Int,
+                physical: WonadPolicyKeyContainment.PhysicalPair, admittedDisplay: Int,
+                retained: DeliveredAuthority?, exactTarget: Boolean,
+                trustedClaimed: Boolean,
+                previous: UnhandledScope?,
+                previousFallback: FallbackScope?,
+            ): UnhandledScope {
+                val exact = exactTarget && retained != null && retained.eventId == eventId &&
+                    retained.physical == physical && retained.display == admittedDisplay
+                return UnhandledScope(
+                    focus, sourceEvent, eventId, physical, admittedDisplay,
+                    retained?.origin?.takeIf { exact }, !exact, trustedClaimed,
+                    previous, previousFallback)
+            }
+        }
+    }
+    private val unhandledScope = ThreadLocal<UnhandledScope?>()
+
+    /**
+     * Exact synchronous derivation scope. It exists only between a successful
+     * KeyCharacterMap lookup and the matching interceptFallback return. The
+     * previous link supports re-entrant Java stacks without retaining history.
+     */
+    internal class FallbackScope private constructor(
+        internal val focus: IBinder,
+        internal val fallbackEvent: KeyEvent,
+        internal val physical: WonadPolicyKeyContainment.PhysicalPair,
+        internal val display: Int,
+        internal val origin: WonadPolicyKeyContainment.ClaimLineage?,
+        internal val blocked: Boolean,
+        internal val previous: FallbackScope?,
+    ) {
+        companion object {
+            internal fun create(focus: IBinder, fallbackEvent: KeyEvent,
+                physical: WonadPolicyKeyContainment.PhysicalPair,
+                display: Int,
+                authority: UnhandledScope,
+                previous: FallbackScope?,
+            ) = FallbackScope(
+                focus, fallbackEvent, physical, display, authority.origin,
+                authority.blocked, previous)
+        }
+    }
+    private val fallbackScope = ThreadLocal<FallbackScope?>()
+
+    /**
+     * The candidate nonce was allocated under InputDispatcher's lock and is
+     * never reused. KeyEvent.id remains bound evidence but is never the
+     * registry key or authority.
+     */
+    private fun publishAuthority(admissionToken: Long, value: KeyEvent,
+        physical: WonadPolicyKeyContainment.PhysicalPair,
+        origin: WonadPolicyKeyContainment.ClaimLineage,
+        pair: WonadPolicyKeyContainment.PairToken): Boolean {
+        val record = DeliveredAuthority(
+            admissionToken, value.id, physical, value.displayId, origin, pair)
+        return synchronized(deliveryLock) {
+            val call = admissionCall.get()
+            if (call == null || call.token != admissionToken || call.registered != null) {
+                return@synchronized false
+            }
+            if (admissionToken <= 0L || admissionToken in deliveries ||
+                deliveries.size >= MAX_PENDING_EVENTS) return@synchronized false
+            // Final successful publication step. All record construction and
+            // every fallible framework action happened before this mutation.
+            try {
+                call.registered = record
+                deliveries[admissionToken] = record
+                true
+            } catch (failure: Throwable) {
+                if (deliveries[admissionToken] === record) {
+                    deliveries.remove(admissionToken)
+                }
+                throw failure
+            }
+        }
+    }
+
+    private fun takeAuthority(token: Long, eventId: Int,
+        physical: WonadPolicyKeyContainment.PhysicalPair,
+        display: Int): DeliveredAuthority? =
+        synchronized(deliveryLock) {
+            if (token <= 0L) return@synchronized null
+            val retained = deliveries[token] ?: return@synchronized null
+            // A stale/malformed cleanup must not erase a later record. The
+            // private 63-bit nonce is primary; source-event facts are bound as
+            // independent corruption controls before removal.
+            if (retained.token != token || retained.eventId != eventId ||
+                retained.physical != physical || retained.display != display) {
+                return@synchronized null
+            }
+            deliveries.remove(token)
+        }
+
+    private fun takePrimitiveAuthority(token: Long, eventId: Int, device: Int,
+        keyCode: Int, downTime: Long, display: Int): DeliveredAuthority? =
+        synchronized(deliveryLock) {
+            if (token <= 0L) return@synchronized null
+            val retained = deliveries[token] ?: return@synchronized null
+            if (retained.token != token || retained.eventId != eventId ||
+                retained.physical.device != device || retained.physical.keyCode != keyCode ||
+                retained.physical.downTime != downTime || retained.display != display) {
+                return@synchronized null
+            }
+            deliveries.remove(token)
+        }
+
+    private fun role(value: Int) = when (value) {
+        ROLE_ORDINARY -> WonadPolicyKeyContainment.Role.ORDINARY
+        ROLE_APP_SWITCH -> WonadPolicyKeyContainment.Role.APP_SWITCH
+        ROLE_RECENT_APPS -> WonadPolicyKeyContainment.Role.RECENT_APPS
+        ROLE_ALL_APPS -> WonadPolicyKeyContainment.Role.ALL_APPS
+        ROLE_SYSTEM_ACTION -> WonadPolicyKeyContainment.Role.SYSTEM_ACTION
+        ROLE_META -> WonadPolicyKeyContainment.Role.META
+        ROLE_ALT -> WonadPolicyKeyContainment.Role.ALT
+        ROLE_TAB -> WonadPolicyKeyContainment.Role.TAB
+        ROLE_ESCAPE -> WonadPolicyKeyContainment.Role.ESCAPE
+        else -> throw IllegalArgumentException("Unknown policy role $value")
+    }
+
+    /** Capture the actual immutable claim object and attachment incarnation. */
+    private fun origin(display: Int): WonadPolicyKeyContainment.ClaimLineage? =
+        WonadUiBridge.currentShortcutClaimState(display)?.claim?.let(::origin)
+
+    private fun origin(claim: WonadUiBridge.ShortcutClaim) =
+        WonadPolicyKeyContainment.ClaimLineage(
+            claim,
+            claim.display,
+            claim.user,
+            claim.generation,
+            claim.incarnation,
+            claim.owner,
+        )
+
+    /** Fallible framework reads happen before the pure helper commit. */
+    private fun observe(context: Context, wm: WindowManagerInternal,
+        retained: WonadPolicyKeyContainment.ClaimLineage):
+        WonadPolicyKeyContainment.ObservedClaim {
+        val claim = retained.claim as? WonadUiBridge.ShortcutClaim
+        val status = if (claim == null || !WonadUiBridge.shortcutClaimCurrent(claim)) {
+            WonadPolicyKeyContainment.ClaimStatus.RETIRED
+        } else if (WonadInputBridge.policyClaimBlocked(context, wm, retained.display)) {
+            WonadPolicyKeyContainment.ClaimStatus.BLOCKED
+        } else {
+            WonadPolicyKeyContainment.ClaimStatus.HEALTHY
+        }
+        return WonadPolicyKeyContainment.ObservedClaim(retained, status)
+    }
+
+    private fun event(value: KeyEvent, display: Int = value.displayId) =
+        WonadPolicyKeyContainment.Event(
+        WonadPolicyKeyContainment.PhysicalPair(
+            value.deviceId,
+            value.keyCode,
+            value.downTime,
+        ),
+        display,
+        if (value.action == KeyEvent.ACTION_DOWN) WonadPolicyKeyContainment.Action.DOWN
+        else WonadPolicyKeyContainment.Action.UP,
+        value.repeatCount,
+        value.isCanceled,
+        value.isAltPressed,
+    )
+
+    private fun matchingFallback(focus: IBinder?, value: KeyEvent): FallbackScope? {
+        if (focus == null || (value.flags and KeyEvent.FLAG_FALLBACK) == 0) return null
+        val current = fallbackScope.get() ?: return null
+        val physical = event(value).physical
+        return current.takeIf {
+            it.focus === focus && it.fallbackEvent === value && it.physical == physical
+        }
+    }
+
+    private fun matchingUnhandled(focus: IBinder?, value: KeyEvent): UnhandledScope? {
+        if (focus == null) return null
+        val current = unhandledScope.get() ?: return null
+        val physical = event(value).physical
+        return current.takeIf {
+            it.trustedClaimed && it.focus === focus && it.sourceEvent === value &&
+                it.eventId == value.id &&
+                it.physical == physical
+        }
+    }
+
+    /**
+     * Read-only stock bookkeeping decision used before platform safety.
+     * This deliberately consults only lock-free WMS publications and pure
+     * pair state: no Settings/provider/WMS call may delay a safety chord.
+     */
+    @JvmStatic
+    fun allowStockBookkeeping(value: KeyEvent): Boolean = state.allowStockBookkeeping(
+        event(value),
+        origin(value.displayId),
+        WonadUiBridge.consumeInput(value.displayId),
+    )
+
+    /** Final route after platform safety, SecurePaste and fixed Wonad command priority. */
+    @JvmStatic
+    fun beforeStock(context: Context, wm: WindowManagerInternal,
+        focus: IBinder?, value: KeyEvent, role: Int): Decision {
+        val fallback = matchingFallback(focus, value)
+        val effectiveDisplay = fallback?.display ?: value.displayId
+        val observed = event(value, effectiveDisplay)
+        val current = fallback?.origin ?: origin(effectiveDisplay)
+        val request = state.prepareObservation(observed, current)
+        val claims = request.origins.map { observe(context, wm, it) }
+        val blocked = focus == null || fallback?.blocked == true ||
+            WonadInputBridge.policyClaimBlocked(context, wm, effectiveDisplay)
+        val raw = state.beforeStock(
+            observed,
+            role(role),
+            current,
+            blocked,
+            WonadPolicyKeyContainment.Observation(request, claims),
+        )
+        if (fallback == null && raw.application && focus == null) {
+            throw IllegalStateException("Application route without focus authority")
+        }
+        val nativeCompletion = fallback == null && raw.application
+        if (nativeCompletion) admissionCall.get()?.provisional = raw.pair
+        return Decision(raw, observed.physical, effectiveDisplay, nativeCompletion)
+    }
+
+    /**
+     * Final publication step immediately before KGC returns the private -3
+     * result.  All SecurePaste/framework work must already have completed.
+     * A collision or bounded-capacity failure converts this exact physical
+     * pair to drain and consumes it; it never produces an ownerless app
+     * dispatch.  The successful map insertion is the last operation on that
+     * path before returning to KGC.
+     */
+    @JvmStatic
+    fun commitNativeCompletion(wm: WindowManagerInternal, value: KeyEvent,
+        policyFlags: Int, admissionToken: Long, decision: Decision): Boolean {
+        val pair = decision.raw.pair
+        val exact = decision.nativeCompletion && decision.application &&
+            decision.matches(value) && pair != null
+        val origin = pair?.origin
+        if (exact && origin != null && publishAuthority(
+                admissionToken, value, event(value).physical, origin, pair)) {
+            return true
+        }
+        state.failApplicationPair(pair, event(value).physical)
+        WonadInputBridge.policyDrainContained(
+            wm,
+            value,
+            policyFlags,
+            (origin?.claim as? WonadUiBridge.ShortcutClaim),
+        )
+        return false
+    }
+
+    /** Drain only the original event; a mismatched Java decision fails closed. */
+    @JvmStatic
+    fun consume(wm: WindowManagerInternal, value: KeyEvent,
+        policyFlags: Int, decision: Decision): Boolean {
+        if (!decision.consume) return false
+        if (decision.matches(value)) {
+            WonadInputBridge.policyDrainContained(
+                wm,
+                value,
+                policyFlags,
+                (decision.raw.pair?.origin?.claim as? WonadUiBridge.ShortcutClaim),
+            )
+        }
+        return true
+    }
+
+    /**
+     * An application may return a claimed key as unhandled. It must not then
+     * re-enter Android global shortcuts. Only InputDispatcher's exact
+     * CONTINUE_WONAD_CLAIMED completion callback can install this synchronous
+     * scope; historical traffic on the same focus/display grants nothing.
+     */
+    @JvmStatic
+    fun bypassUnhandledStock(focus: IBinder?, value: KeyEvent): Boolean {
+        return matchingUnhandled(focus, value) != null ||
+            matchingFallback(focus, value) != null
+    }
+
+    /** Consume one exact native dispatch marker before default processing. */
+    @JvmStatic
+    fun beginUnhandled(wm: WindowManagerInternal, focus: IBinder?, value: KeyEvent,
+        wonadClaimed: Boolean, admissionToken: Long, admittedDisplay: Int): Any? {
+        val physical = event(value).physical
+        val retained = if (wonadClaimed) takeAuthority(
+            admissionToken, value.id, physical, admittedDisplay) else null
+        val target = if (wonadClaimed && focus != null) wm.getInputTargetInfo(focus) else null
+        val exactTarget = retained != null && target != null &&
+            target.displayId == retained.display && retained.display == admittedDisplay
+        val scope = UnhandledScope.create(
+            focus, value, value.id, physical, admittedDisplay, retained, exactTarget, wonadClaimed,
+            unhandledScope.get(), fallbackScope.get())
+        // A nested STOCK invocation must not inherit an outer claimed scope,
+        // even if collision-prone public IDs/physical facts happen to match.
+        fallbackScope.set(null)
+        unhandledScope.set(scope)
+        return scope
+    }
+
+    @JvmStatic
+    fun endUnhandled(value: Any?) {
+        if (value == null) return
+        val expected = value as? UnhandledScope
+            ?: throw IllegalArgumentException("Unknown unhandled scope")
+        check(unhandledScope.get() === expected) { "Unhandled scope order changed" }
+        unhandledScope.set(expected.previous)
+        fallbackScope.set(expected.previousFallback)
+    }
+
+    /** Primitive-only JNI cleanup avoids allocating another Java KeyEvent. */
+    @JvmStatic
+    fun finishHandled(admissionToken: Long, eventId: Int, device: Int, keyCode: Int,
+        downTime: Long, display: Int, abandoned: Boolean = false): Boolean {
+        val retained = takePrimitiveAuthority(
+            admissionToken, eventId, device, keyCode, downTime, display) ?: return false
+        if (abandoned) state.failApplicationPair(retained.pair, retained.physical)
+        return true
+    }
+
+    /**
+     * Begin exact fallback inheritance only after KeyCharacterMap returned a
+     * real fallback. A null result means this source event was never delivered
+     * under a claimed focus/display authority and must keep stock behavior.
+     */
+    @JvmStatic
+    fun beginFallback(focus: IBinder?, source: KeyEvent,
+        fallback: KeyEvent): Any? {
+        if (focus == null || (fallback.flags and KeyEvent.FLAG_FALLBACK) == 0) return null
+        val retained = matchingUnhandled(focus, source) ?: return null
+        val scope = FallbackScope.create(
+            focus, fallback, event(fallback).physical, retained.display, retained,
+            fallbackScope.get())
+        fallbackScope.set(scope)
+        return scope
+    }
+
+    /** Exact finally-only release; a mismatched stack is fail-stop, not aliasing. */
+    @JvmStatic
+    fun endFallback(value: Any?) {
+        if (value == null) return
+        val expected = value as? FallbackScope
+            ?: throw IllegalArgumentException("Unknown fallback scope")
+        check(fallbackScope.get() === expected) { "Fallback scope order changed" }
+        fallbackScope.set(expected.previous)
+    }
+
+    /** Prevent a derived fallback from re-entering PWM queue-time policy. */
+    @JvmStatic
+    fun bypassFallbackQueueing(focus: IBinder?, value: KeyEvent): Boolean {
+        return matchingFallback(focus, value) != null
+    }
+
+    @JvmStatic
+    fun onClaimContainmentChanged(claim: WonadUiBridge.ShortcutClaim, blocked: Boolean) =
+        state.onClaimContainmentChanged(origin(claim), blocked)
+
+    @JvmStatic
+    fun onClaimRetiring(claim: WonadUiBridge.ShortcutClaim) =
+        state.onClaimRetiring(origin(claim))
+
+    @JvmStatic
+    fun onClaimRetired(claim: WonadUiBridge.ShortcutClaim) =
+        state.onClaimRetired(origin(claim))
+
+    /** Synchronous bridge-side guard for a lifecycle state not yet unpublished. */
+    @JvmStatic
+    fun claimBlocked(claim: WonadUiBridge.ShortcutClaim): Boolean =
+        state.claimStatus(origin(claim))?.let {
+            it != WonadPolicyKeyContainment.ClaimStatus.HEALTHY
+        } ?: false
+
+    @JvmStatic fun removeDevice(device: Int): Boolean = state.removeDevice(device)
+    @JvmStatic fun mutationEpoch(): Long = state.mutationEpoch()
+    @JvmStatic fun reconcileDevices(present: IntArray, allKeysReleased: Boolean,
+        expectedEpoch: Long): Boolean =
+        state.reconcileDevices(present.toSet(), allKeysReleased, expectedEpoch)
+}
