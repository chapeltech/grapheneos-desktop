--- /dev/null
+++ b/android/input-integration/src/org/wonad/server/input/WonadPolicyKeyContainment.kt
@@ -0,0 +1,407 @@
+package org.wonad.server.input
+
+import java.util.IdentityHashMap
+
+/**
+ * Bounded, identity-exact routing state for the KeyGestureController seam.
+ *
+ * Platform safety chords and SecurePaste run before this state machine. Once
+ * an event reaches it, an exact healthy claimed external origin has only two
+ * outcomes: ordinary/modifier/Escape input is returned to the application, or
+ * an Android-desktop UI key is consumed as an exact physical pair. No healthy
+ * claimed event enters Android's stock global-shortcut or Recents stages.
+ */
+internal class WonadPolicyKeyContainment(
+    private val maximumPairs: Int = 256,
+) {
+    init { require(maximumPairs >= 8) }
+
+    internal enum class Role {
+        ORDINARY,
+        APP_SWITCH,
+        RECENT_APPS,
+        ALL_APPS,
+        SYSTEM_ACTION,
+        META,
+        ALT,
+        TAB,
+        ESCAPE,
+    }
+
+    internal enum class Action { DOWN, UP }
+    internal enum class ClaimStatus { HEALTHY, BLOCKED, RETIRED }
+    internal enum class Route { STOCK, APPLICATION, CONSUME }
+
+    internal data class PhysicalPair(
+        val device: Int,
+        val keyCode: Int,
+        val downTime: Long,
+    )
+
+    private data class Slot(val device: Int, val keyCode: Int)
+
+    /** Exact private Android object identities plus immutable scalar mirrors. */
+    internal class ClaimLineage(
+        internal val claim: Any,
+        internal val display: Int,
+        internal val user: Int,
+        internal val generation: Long,
+        internal val incarnation: Long,
+        internal val binder: Any,
+    ) {
+        internal fun sameExact(other: ClaimLineage?): Boolean = other != null &&
+            claim === other.claim && binder === other.binder &&
+            display == other.display && user == other.user &&
+            generation == other.generation && incarnation == other.incarnation
+    }
+
+    internal data class Event(
+        val physical: PhysicalPair,
+        val display: Int,
+        val action: Action,
+        val repeat: Int,
+        val canceled: Boolean,
+        val altPressed: Boolean,
+    ) {
+        internal val firstDown: Boolean get() = action == Action.DOWN && repeat == 0
+        internal val terminal: Boolean get() = action == Action.UP || canceled
+    }
+
+    /** Retained exact pair. [route] never changes after the first DOWN. */
+    internal class PairToken(
+        internal val physical: PhysicalPair,
+        internal val role: Role,
+        internal val display: Int,
+        // null is an unclaimed/phone pair whose initial DOWN was admitted to
+        // stock policy.  That exact pair remains stock through its terminal,
+        // even if a claim is published in the meantime.
+        internal val origin: ClaimLineage?,
+        internal val route: Route,
+    )
+
+    private class Record(
+        val token: PairToken,
+        var draining: Boolean,
+    )
+
+    internal data class Decision(
+        val route: Route,
+        val pair: PairToken?,
+        val saturated: Boolean,
+    ) {
+        val consume: Boolean get() = route == Route.CONSUME
+        val application: Boolean get() = route == Route.APPLICATION
+        val stock: Boolean get() = route == Route.STOCK
+    }
+
+    /** Pure token captured before fallible framework state is read. */
+    internal data class ObservationRequest(
+        internal val physical: PhysicalPair,
+        internal val lifecycleEpoch: Long,
+        internal val origins: List<ClaimLineage>,
+    )
+
+    /** Immutable result of framework reads made with no helper monitor held. */
+    internal data class ObservedClaim(
+        internal val origin: ClaimLineage,
+        internal val status: ClaimStatus,
+    )
+
+    internal data class Observation(
+        internal val request: ObservationRequest,
+        internal val claims: List<ObservedClaim>,
+    ) {
+        internal fun status(origin: ClaimLineage): ClaimStatus? =
+            claims.firstOrNull { it.origin.sameExact(origin) }?.status
+    }
+
+    private val active = LinkedHashMap<Slot, Record>()
+    // A replacement DOWN must not allow the displaced physical UP to affect a
+    // new phone or claim owner reusing the same device/key slot.
+    private val drains = LinkedHashMap<PhysicalPair, PairToken>()
+    private val claimStatus = IdentityHashMap<Any, ClaimStatus>()
+    // Exhaustion is isolated to the physical device which could no longer be
+    // represented exactly.  A different phone keyboard remains stock.
+    private val saturatedDevices = LinkedHashSet<Int>()
+    private var mutationEpoch = 1L
+    private var lifecycleEpoch = 1L
+
+    private fun mutated() {
+        mutationEpoch = Math.addExact(mutationEpoch, 1L)
+    }
+
+    private fun sameOrigin(left: ClaimLineage?, right: ClaimLineage?): Boolean =
+        left != null && left.sameExact(right)
+
+    private fun addDrain(token: PairToken) {
+        if (drains.size >= maximumPairs && token.physical !in drains) {
+            // Exact authority cannot be silently evicted. Exceptional ledger
+            // exhaustion is released only by a trusted complete key census.
+            saturatedDevices += token.physical.device
+            return
+        }
+        drains[token.physical] = token
+    }
+
+    private fun retire(record: Record, retainDrain: Boolean) {
+        record.draining = true
+        if (retainDrain) addDrain(record.token)
+    }
+
+    private fun claimedRoute(event: Event, role: Role): Route = when (role) {
+        Role.APP_SWITCH, Role.RECENT_APPS, Role.ALL_APPS, Role.SYSTEM_ACTION -> Route.CONSUME
+        // Consume only the Tab pair. The ordinary Alt DOWN/UP pair remains
+        // balanced application input and never creates Android Alt-Tab state.
+        Role.TAB -> if (event.altPressed) Route.CONSUME else Route.APPLICATION
+        else -> Route.APPLICATION
+    }
+
+    /** Claimed traffic and no-claim/phone traffic have independent reserves. */
+    private fun activeAtCapacity(origin: ClaimLineage?): Boolean =
+        active.values.count { (it.token.origin == null) == (origin == null) } >= maximumPairs
+
+    private fun status(origin: ClaimLineage, observation: Observation): ClaimStatus {
+        val published = claimStatus[origin.claim]
+        if (observation.request.lifecycleEpoch != lifecycleEpoch) return ClaimStatus.RETIRED
+        val observed = observation.status(origin) ?: return ClaimStatus.RETIRED
+        // Either the synchronous lifecycle mirror or external framework state
+        // can make an origin less authoritative; neither can make it healthier.
+        return when {
+            published == ClaimStatus.RETIRED || observed == ClaimStatus.RETIRED ->
+                ClaimStatus.RETIRED
+            published == ClaimStatus.BLOCKED || observed == ClaimStatus.BLOCKED ->
+                ClaimStatus.BLOCKED
+            else -> ClaimStatus.HEALTHY
+        }
+    }
+
+    /**
+     * Capture only immutable identities while holding the helper monitor.
+     * The adapter releases this monitor, performs all WMS/settings/framework
+     * reads, then supplies their immutable results to [beforeStock].
+     */
+    @Synchronized
+    internal fun prepareObservation(
+        event: Event,
+        currentOrigin: ClaimLineage?,
+    ): ObservationRequest {
+        val origins = ArrayList<ClaimLineage>(2)
+        active[Slot(event.physical.device, event.physical.keyCode)]?.token?.origin?.let {
+            if (it.sameExact(currentOrigin).not()) origins += it
+        }
+        currentOrigin?.let { origins += it }
+        return ObservationRequest(event.physical, lifecycleEpoch, origins)
+    }
+
+    /**
+     * Read-only decision for stock's two global pending-Boolean clears which
+     * occur before multi-key safety. A claimed or retained claimed event must
+     * not cancel an unrelated phone Meta/Caps sequence.
+     */
+    @Synchronized
+    internal fun allowStockBookkeeping(
+        event: Event,
+        currentOrigin: ClaimLineage?,
+        currentDisplayBlocked: Boolean,
+    ): Boolean {
+        val record = active[Slot(event.physical.device, event.physical.keyCode)]
+        // Preserve the exact terminal bookkeeping for a stock DOWN which was
+        // admitted before this display became claimed.
+        if (record != null && record.token.physical == event.physical &&
+            record.token.origin == null) return record.token.route == Route.STOCK
+        if (event.physical.device in saturatedDevices || currentDisplayBlocked ||
+            currentOrigin != null) return false
+        if (event.physical in drains) return false
+        return record == null || record.token.physical != event.physical
+    }
+
+    /**
+     * Observe one physical event after platform safety, SecurePaste policy and
+     * fixed Wonad/Rust command priority.
+     */
+    @Synchronized
+    internal fun beforeStock(
+        event: Event,
+        role: Role,
+        currentOrigin: ClaimLineage?,
+        currentDisplayBlocked: Boolean,
+        observation: Observation,
+    ): Decision {
+        mutated()
+        var deviceSaturated = event.physical.device in saturatedDevices
+        val observationMatches = observation.request.physical == event.physical
+
+        // Exact late UP from a displaced pair is always drained. It cannot
+        // clear or complete the replacement occupying the same device/key.
+        drains[event.physical]?.let { token ->
+            if (event.terminal) drains.remove(event.physical)
+            return Decision(Route.CONSUME, token, deviceSaturated)
+        }
+
+        val slot = Slot(event.physical.device, event.physical.keyCode)
+        var record = active[slot]
+
+        if (event.firstDown && record != null &&
+            record.token.physical.downTime != event.physical.downTime) {
+            active.remove(slot)
+            retire(record, retainDrain = true)
+            deviceSaturated = event.physical.device in saturatedDevices
+            record = null
+        }
+
+        if (record != null && record.token.physical == event.physical) {
+            // Initial-DOWN authority is stable for the whole physical pair.
+            // In particular, a phone/unclaimed DOWN completes stock policy
+            // after claim publication rather than being retroactively stolen.
+            if (record.token.origin == null) {
+                if (event.terminal) active.remove(slot)
+                return Decision(record.token.route, record.token, deviceSaturated)
+            }
+            val healthy = observationMatches &&
+                status(record.token.origin, observation) == ClaimStatus.HEALTHY
+            // A migrated event stamped with a different claim or phone display
+            // remains the original external physical pair and must not leak.
+            val exactCurrent = sameOrigin(record.token.origin, currentOrigin)
+            if (deviceSaturated || currentDisplayBlocked || !healthy || !exactCurrent) {
+                record.draining = true
+            }
+            val route = if (record.draining) Route.CONSUME else record.token.route
+            if (event.terminal) active.remove(slot)
+            return Decision(route, record.token, deviceSaturated)
+        }
+
+        if (currentOrigin == null) {
+            // A sticky blank/protected barrier can outlive publication of the
+            // exact shortcut claim. It remains fail-black.
+            val route = if (deviceSaturated || currentDisplayBlocked) {
+                Route.CONSUME
+            } else {
+                Route.STOCK
+            }
+            if (event.action == Action.DOWN) {
+                val token = PairToken(event.physical, role, event.display, origin = null,
+                    route = route)
+                if (activeAtCapacity(origin = null) && slot !in active) {
+                    saturatedDevices += event.physical.device
+                    return Decision(Route.CONSUME, token, saturated = true)
+                }
+                active[slot] = Record(token, draining = route == Route.CONSUME)
+                return Decision(route, token,
+                    event.physical.device in saturatedDevices)
+            }
+            return Decision(route, null, deviceSaturated)
+        }
+
+        val healthy = observationMatches &&
+            status(currentOrigin, observation) == ClaimStatus.HEALTHY
+        val route = if (deviceSaturated || currentDisplayBlocked || !healthy) {
+            Route.CONSUME
+        } else {
+            claimedRoute(event, role)
+        }
+
+        // Repeat-without-DOWN is not allowed to enter stock policy. Retain it
+        // when possible so its terminal is routed consistently.
+        if (event.action == Action.DOWN) {
+            val token = PairToken(event.physical, role, event.display, currentOrigin, route)
+            if (activeAtCapacity(currentOrigin) && slot !in active) {
+                saturatedDevices += event.physical.device
+                return Decision(Route.CONSUME, token, saturated = true)
+            }
+            active[slot] = Record(token, draining = route == Route.CONSUME)
+            return Decision(route, token,
+                event.physical.device in saturatedDevices)
+        }
+
+        // A claimed terminal observed without its DOWN cannot invoke Android
+        // stock UI. It is consumed rather than manufacturing owner state.
+        return Decision(Route.CONSUME, null, deviceSaturated)
+    }
+
+    @Synchronized
+    internal fun onClaimContainmentChanged(origin: ClaimLineage, blocked: Boolean) {
+        mutated()
+        lifecycleEpoch = Math.addExact(lifecycleEpoch, 1L)
+        claimStatus[origin.claim] = if (blocked) ClaimStatus.BLOCKED else ClaimStatus.HEALTHY
+        if (blocked) {
+            active.values.filter { sameOrigin(it.token.origin, origin) }
+                .forEach { it.draining = true }
+        }
+    }
+
+    /**
+     * Convert one provisionally admitted application pair to permanent drain
+     * when the bounded native-completion registry cannot publish its exact
+     * authority.  The PairToken identity prevents a colliding/replacement
+     * event from draining some newer occupant of the same device/key slot.
+     */
+    @Synchronized
+    internal fun failApplicationPair(token: PairToken?, physical: PhysicalPair): Boolean {
+        mutated()
+        if (token == null || token.route != Route.APPLICATION || token.physical != physical) {
+            return false
+        }
+        val slot = Slot(physical.device, physical.keyCode)
+        val record = active[slot] ?: return false
+        if (record.token !== token || record.token.physical != physical) return false
+        record.draining = true
+        return true
+    }
+
+    @Synchronized
+    internal fun onClaimRetiring(origin: ClaimLineage) {
+        mutated()
+        lifecycleEpoch = Math.addExact(lifecycleEpoch, 1L)
+        claimStatus[origin.claim] = ClaimStatus.RETIRED
+        active.values.filter { sameOrigin(it.token.origin, origin) }
+            .forEach { it.draining = true }
+    }
+
+    @Synchronized
+    internal fun onClaimRetired(origin: ClaimLineage) {
+        mutated()
+        lifecycleEpoch = Math.addExact(lifecycleEpoch, 1L)
+        claimStatus.remove(origin.claim)
+    }
+
+    @Synchronized
+    internal fun claimStatus(origin: ClaimLineage): ClaimStatus? = claimStatus[origin.claim]
+
+    @Synchronized
+    internal fun removeDevice(device: Int): Boolean {
+        mutated()
+        active.entries.removeIf { it.key.device == device }
+        drains.entries.removeIf { it.key.device == device }
+        saturatedDevices.remove(device)
+        return saturatedDevices.isNotEmpty()
+    }
+
+    @Synchronized internal fun mutationEpoch(): Long = mutationEpoch
+
+    /**
+     * Release exceptional saturation only from an unchanged complete native
+     * all-key-UP census. Device removal alone cannot prove that no DOWN raced.
+     */
+    @Synchronized
+    internal fun reconcileDevices(
+        presentDevices: Set<Int>,
+        allKeysReleased: Boolean,
+        expectedEpoch: Long,
+    ): Boolean {
+        if (expectedEpoch != mutationEpoch) return saturatedDevices.isNotEmpty()
+        mutated()
+        active.entries.removeIf { it.key.device !in presentDevices }
+        drains.entries.removeIf { it.key.device !in presentDevices }
+        saturatedDevices.removeIf { it !in presentDevices }
+        if (saturatedDevices.isNotEmpty() && allKeysReleased) {
+            active.clear()
+            drains.clear()
+            saturatedDevices.clear()
+        }
+        return saturatedDevices.isNotEmpty()
+    }
+
+    @Synchronized internal fun activeCount(): Int = active.size
+    @Synchronized internal fun drainCount(): Int = drains.size
+
+}
