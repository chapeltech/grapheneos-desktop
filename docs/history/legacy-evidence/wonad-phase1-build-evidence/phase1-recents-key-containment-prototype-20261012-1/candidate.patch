+    private boolean interceptWonadContainedBeforeKeyCapture(@Nullable IBinder focusedToken,
+            @NonNull KeyEvent event, int policyFlags) {
+        final int keyCode = event.getKeyCode();
+        final InterceptKeyStage stockStage =
+                mInterceptStages.get(INTERCEPT_STAGE_SHORTCUTS_BEFORE_KEY_CAPTURE);
+        final boolean blocked =
+                org.wonad.server.input.WonadInputBridge.consumeClaimedInput(
+                        mContext, mWindowManagerInternal, event, policyFlags);
+        if (keyCode != KeyEvent.KEYCODE_APP_SWITCH
+                && keyCode != KeyEvent.KEYCODE_RECENT_APPS) {
+            if (!blocked) {
+                return false;
+            }
+            // A new physical pair supersedes any stock ledger entry left by a device which
+            // vanished without UP. A stale old UP must not clear a newer pair with a different
+            // downTime; the exact-pair branch handles that distinction.
+            if (event.getAction() == KeyEvent.ACTION_DOWN && event.getRepeatCount() == 0) {
+                stockStage.forgetConsumedKey(event.getDeviceId(), keyCode);
+            } else {
+                stockStage.forgetConsumedKey(event);
+            }
+            if (keyCode == KeyEvent.KEYCODE_ESCAPE) {
+                cancelPendingExitFocusedApp(event, /* replacement = */
+                        event.getAction() == KeyEvent.ACTION_DOWN
+                                && event.getRepeatCount() == 0);
+            }
+            return true;
+        }
+        for (WonadRecentsKeyContainment.RetiredPair retired :
+                mWonadRecentsKeyContainment.retireMissingDevices(
+                        deviceId -> deviceId < 0 || getInputDevice(deviceId) != null)) {
+            stockStage.forgetConsumedKey(retired.deviceId, retired.keyCode);
+            if (retired.cancelStockAppSwitch) {
+                handleKeyGesture(retired.deviceId, new int[]{retired.keyCode},
+                        /* modifierState = */ 0,
+                        KeyGestureEvent.KEY_GESTURE_TYPE_APP_SWITCH,
+                        KeyGestureEvent.ACTION_GESTURE_COMPLETE, retired.displayId,
+                        /* focusedToken = */ null, KeyGestureEvent.FLAG_CANCELLED,
+                        /* appLaunchData = */ null);
+            }
+        }
+        final boolean stockWillConsumeFirstDown = event.getAction() == KeyEvent.ACTION_DOWN
+                && event.getRepeatCount() == 0
+                && (event.getMetaState() & SHORTCUT_META_MASK) == 0;
+        final WonadRecentsKeyContainment.Decision decision =
+                mWonadRecentsKeyContainment.onKeyEvent(event, blocked,
+                        stockStage.isKeyConsumed(event), stockWillConsumeFirstDown);
+        if (decision.cancelStockAppSwitch) {
+            handleKeyGesture(event.getDeviceId(), new int[]{keyCode},
+                    /* modifierState = */ 0, KeyGestureEvent.KEY_GESTURE_TYPE_APP_SWITCH,
+                    KeyGestureEvent.ACTION_GESTURE_COMPLETE, decision.cancelDisplayId,
+                    focusedToken, KeyGestureEvent.FLAG_CANCELLED,
+                    /* appLaunchData = */ null);
+        }
+        if (decision.forgetStockPair) {
+            stockStage.forgetConsumedKey(event.getDeviceId(), keyCode);
+        }
+        return decision.consume;
+    }
