+    /**
+     * Tracks only fail-black Recents pairs. A blocked first DOWN never reaches stock. If stock
+     * already consumed a healthy APP_SWITCH DOWN, the first subsequently blocked event requests
+     * one cancelled COMPLETE so PhoneWindowManager can unwind its preload. The rest of either
+     * pair remains consumed even if the claim becomes healthy before UP.
+     */
+    private static final class WonadRecentsKeyContainment {
+        private static final int PAIR_DRAINING = 1;
+        private static final int PAIR_STOCK = 2;
+
+        static final class Decision {
+            final boolean consume;
+            final boolean forgetStockPair;
+            final boolean cancelStockAppSwitch;
+            final int cancelDisplayId;
+
+            Decision(boolean consume, boolean forgetStockPair,
+                    boolean cancelStockAppSwitch, int cancelDisplayId) {
+                this.consume = consume;
+                this.forgetStockPair = forgetStockPair;
+                this.cancelStockAppSwitch = cancelStockAppSwitch;
+                this.cancelDisplayId = cancelDisplayId;
+            }
+        }
+
+        static final class RetiredPair {
+            final int deviceId;
+            final int keyCode;
+            final int displayId;
+            final boolean cancelStockAppSwitch;
+
+            RetiredPair(int deviceId, int keyCode, int displayId,
+                    boolean cancelStockAppSwitch) {
+                this.deviceId = deviceId;
+                this.keyCode = keyCode;
+                this.displayId = displayId;
+                this.cancelStockAppSwitch = cancelStockAppSwitch;
+            }
+        }
+
+        private static final class Pair {
+            final long downTime;
+            final int displayId;
+            int state;
+
+            Pair(long downTime, int displayId, int state) {
+                this.downTime = downTime;
+                this.displayId = displayId;
+                this.state = state;
+            }
+        }
+
+        private final SparseArray<SparseArray<Pair>> mPairsForDevice = new SparseArray<>();
+
+        List<RetiredPair> retireMissingDevices(@NonNull IntPredicate present) {
+            final ArrayList<RetiredPair> retired = new ArrayList<>();
+            for (int deviceIndex = mPairsForDevice.size() - 1; deviceIndex >= 0; deviceIndex--) {
+                final int deviceId = mPairsForDevice.keyAt(deviceIndex);
+                if (present.test(deviceId)) {
+                    continue;
+                }
+                final SparseArray<Pair> pairs = mPairsForDevice.valueAt(deviceIndex);
+                for (int pairIndex = 0; pairIndex < pairs.size(); pairIndex++) {
+                    final int keyCode = pairs.keyAt(pairIndex);
+                    final Pair pair = pairs.valueAt(pairIndex);
+                    retired.add(new RetiredPair(deviceId, keyCode, pair.displayId,
+                            pair.state == PAIR_STOCK
+                                    && keyCode == KeyEvent.KEYCODE_APP_SWITCH));
+                }
+                mPairsForDevice.removeAt(deviceIndex);
+            }
+            return retired;
+        }
+
+        Decision onKeyEvent(@NonNull KeyEvent event, boolean blocked, boolean stockConsumed,
+                boolean stockWillConsumeFirstDown) {
+            final int keyCode = event.getKeyCode();
+            if (keyCode != KeyEvent.KEYCODE_APP_SWITCH
+                    && keyCode != KeyEvent.KEYCODE_RECENT_APPS) {
+                return decision(false, false, false, event.getDisplayId());
+            }
+            final int deviceId = event.getDeviceId();
+            final long downTime = event.getDownTime();
+            final boolean firstDown = event.getAction() == KeyEvent.ACTION_DOWN
+                    && event.getRepeatCount() == 0;
+            final boolean terminal = event.getAction() == KeyEvent.ACTION_UP
+                    || event.isCanceled();
+            final SparseArray<Pair> pairs = mPairsForDevice.get(deviceId);
+            Pair current = pairs == null ? null : pairs.get(keyCode);
+
+            // A repeatCount=0 DOWN with a new downTime is a new physical pair, even if an old
+            // keyboard vanished without UP and its numeric device ID was later reused. Retire the
+            // old pair before stock sees the new event. A best-effort cancelled COMPLETE is safe:
+            // PhoneWindowManager accepts it only if the old device/display still owns preload.
+            if (firstDown && (current == null || current.downTime != downTime)) {
+                final boolean oldStockPair = current != null && current.state == PAIR_STOCK;
+                final boolean forgetOld = oldStockPair || stockConsumed;
+                final boolean cancelOld = forgetOld
+                        && keyCode == KeyEvent.KEYCODE_APP_SWITCH;
+                final int cancelDisplay = current == null
+                        ? event.getDisplayId() : current.displayId;
+                if (current != null) {
+                    removePair(deviceId, keyCode, pairs);
+                }
+                if (blocked) {
+                    putPair(deviceId, keyCode,
+                            new Pair(downTime, event.getDisplayId(), PAIR_DRAINING));
+                    return decision(true, forgetOld, cancelOld, cancelDisplay);
+                }
+                if (stockWillConsumeFirstDown) {
+                    putPair(deviceId, keyCode,
+                            new Pair(downTime, event.getDisplayId(), PAIR_STOCK));
+                }
+                return decision(false, forgetOld, cancelOld, cancelDisplay);
+            }
+
+            // Never let a late event from a retired pair mutate the replacement pair's stock
+            // ledger. In particular, an old external UP cannot complete a fresh phone DOWN.
+            if (current != null && current.downTime != downTime) {
+                return decision(true, false, false, current.displayId);
+            }
+
+            if (current != null && current.state == PAIR_DRAINING) {
+                if (terminal) {
+                    removePair(deviceId, keyCode, pairs);
+                }
+                return decision(true, false, false, current.displayId);
+            }
+
+            if (current != null) {
+                if (blocked) {
+                    if (terminal) {
+                        removePair(deviceId, keyCode, pairs);
+                    } else {
+                        current.state = PAIR_DRAINING;
+                    }
+                    return decision(true, true,
+                            keyCode == KeyEvent.KEYCODE_APP_SWITCH, current.displayId);
+                }
+                if (terminal) {
+                    removePair(deviceId, keyCode, pairs);
+                }
+                return decision(false, false, false, current.displayId);
+            }
+
+            if (blocked || stockConsumed) {
+                if (!terminal) {
+                    putPair(deviceId, keyCode,
+                            new Pair(downTime, event.getDisplayId(), PAIR_DRAINING));
+                }
+                return decision(true, stockConsumed,
+                        stockConsumed && keyCode == KeyEvent.KEYCODE_APP_SWITCH,
+                        event.getDisplayId());
+            }
+
+            // Stock APP_SWITCH emits COMPLETE from any unmodified UP, even if it never observed
+            // the matching DOWN. Consume such an unowned terminal event rather than toggling
+            // global phone Recents. Normal phone/external pairs were recorded at first DOWN.
+            if (keyCode == KeyEvent.KEYCODE_APP_SWITCH && terminal) {
+                return decision(true, false, false, event.getDisplayId());
+            }
+            return decision(false, false, false, event.getDisplayId());
+        }
+
+        private static Decision decision(boolean consume, boolean forgetStockPair,
+                boolean cancelStockAppSwitch, int cancelDisplayId) {
+            return new Decision(consume, forgetStockPair,
+                    cancelStockAppSwitch, cancelDisplayId);
+        }
+
+        private void putPair(int deviceId, int keyCode, Pair pair) {
+            SparseArray<Pair> pairs = mPairsForDevice.get(deviceId);
+            if (pairs == null) {
+                pairs = new SparseArray<>();
+                mPairsForDevice.put(deviceId, pairs);
+            }
+            pairs.put(keyCode, pair);
+        }
+
+        private void removePair(int deviceId, int keyCode, @NonNull SparseArray<Pair> pairs) {
+            pairs.remove(keyCode);
+            if (pairs.size() == 0) {
+                mPairsForDevice.remove(deviceId);
+            }
+        }
+    }
