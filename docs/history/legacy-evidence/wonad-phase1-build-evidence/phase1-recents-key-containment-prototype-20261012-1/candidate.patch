+    /** Complete a delayed Escape only while its exact record still owns the device slot. */
+    private void completePendingExitFocusedApp(@NonNull AidlKeyGestureEvent completion) {
+        boolean owned = false;
+        synchronized (mPendingExitFocusedApps) {
+            for (int index = 0; index < mPendingExitFocusedApps.size(); index++) {
+                if (mPendingExitFocusedApps.valueAt(index).completion == completion) {
+                    mPendingExitFocusedApps.removeAt(index);
+                    owned = true;
+                    break;
+                }
+            }
+        }
+        if (owned) {
+            handleKeyGesture(completion, /* focusedToken = */ null);
+        }
+    }
