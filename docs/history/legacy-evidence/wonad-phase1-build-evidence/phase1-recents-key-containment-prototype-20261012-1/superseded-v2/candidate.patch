+        private void forgetConsumedKey(@NonNull KeyEvent event) {
+            final int deviceId = event.getDeviceId();
+            final Set<Integer> consumedKeys = mConsumedKeysForDevice.get(deviceId);
+            if (consumedKeys == null) {
