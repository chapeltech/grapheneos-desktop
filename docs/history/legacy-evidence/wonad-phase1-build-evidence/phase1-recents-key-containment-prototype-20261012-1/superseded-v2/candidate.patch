+    /**
+     * Tracks only fail-black Recents pairs. A blocked first DOWN never reaches stock. If stock
+     * already consumed a healthy APP_SWITCH DOWN, the first subsequently blocked event requests
+     * one cancelled COMPLETE so PhoneWindowManager can unwind its preload. The rest of either
+     * pair remains consumed even if the claim becomes healthy before UP.
+     */
+    private static final class WonadRecentsKeyContainment {
+        static final int PASS = 0;
+        static final int CONSUME = 1;
+        static final int CANCEL_STOCK_APP_SWITCH = 2;
+        static final int FORGET_STOCK_PAIR = 3;
+
+        private static final int PAIR_DRAINING = 1;
+        private final SparseArray<SparseIntArray> mPairsForDevice = new SparseArray<>();
+
+        int onKeyEvent(@NonNull KeyEvent event, boolean blocked, boolean stockConsumed) {
+            final int keyCode = event.getKeyCode();
+            if (keyCode != KeyEvent.KEYCODE_APP_SWITCH
+                    && keyCode != KeyEvent.KEYCODE_RECENT_APPS) {
+                return PASS;
+            }
+            final int deviceId = event.getDeviceId();
+            final boolean terminal = event.getAction() == KeyEvent.ACTION_UP
+                    || event.isCanceled();
+            final SparseIntArray pairs = mPairsForDevice.get(deviceId);
+            if (pairs != null && pairs.get(keyCode, 0) == PAIR_DRAINING) {
+                if (terminal) {
+                    pairs.delete(keyCode);
+                    if (pairs.size() == 0) {
+                        mPairsForDevice.remove(deviceId);
+                    }
+                }
+                return CONSUME;
+            }
+            if (!blocked) {
+                return PASS;
+            }
+            if (!terminal) {
+                SparseIntArray draining = pairs;
+                if (draining == null) {
+                    draining = new SparseIntArray();
+                    mPairsForDevice.put(deviceId, draining);
+                }
+                draining.put(keyCode, PAIR_DRAINING);
+            }
+            if (!stockConsumed) {
+                return CONSUME;
+            }
+            return keyCode == KeyEvent.KEYCODE_APP_SWITCH
+                    ? CANCEL_STOCK_APP_SWITCH : FORGET_STOCK_PAIR;
+        }
+    }
